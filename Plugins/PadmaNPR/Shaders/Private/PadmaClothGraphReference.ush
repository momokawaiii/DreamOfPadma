    float3 n79 = lerp(n76,n78,P_GGX_Camera_Strengh); // MaterialExpressionLinearInterpolate_5
    float3 n80 = normalize(n79); // MaterialExpressionNormalize_2
    float3 n81 = mul(TangentToWorld,n80); // MaterialExpressionTransform_5
    float n82 = dot(n56.rgba,P_Glossiness); // MaterialExpressionChannelMaskParameter_2
    float n83 = saturate(n82.r*P_Glossiness_Mask_Smooth-P_Glossiness_Mask_Offset); // MaterialExpressionMaterialFunctionCall_3
    float n84 = (1-(n83)); // MaterialExpressionOneMinus_4
    float n85 = PadmaReferenceGGX(n75,n81,n84); // MaterialExpressionMaterialFunctionCall_10
    float n86 = (n85 * n58); // MaterialExpressionMultiply_5
    float n87 = dot(n56.rgba,P_Matallic); // MaterialExpressionChannelMaskParameter_0
    float n88 = saturate(n87.r*P_Metallic_Mask_Smooth-P_Metallic_Mask_Offset); // MaterialExpressionMaterialFunctionCall_0
    float n89 = (n86 * n88); // MaterialExpressionMultiply_7
    float n90 = lerp(n86,n89,P_GGX_Metallic_Strengh); // MaterialExpressionLinearInterpolate_6
    float n91 = saturate(n90*P_GGX_Smooth-P_GGX_Offset); // MaterialExpressionMaterialFunctionCall_12
    float n92 = (n91 * n53); // MaterialExpressionMultiply_6
    float n93 = lerp(n91,n92,P_GGX_Lam_Strengh); // MaterialExpressionLinearInterpolate_7
    float n94 = saturate(n93); // MaterialExpressionSaturate_0
    float3 n95 = lerp(n73,lerp(n73*P_GGX_Color.rgb,P_GGX_Color.rgb,P_GGX_Color.a),n94); // MaterialExpressionMaterialFunctionCall_13
    float n96 = (n26.rgba).a; // MaterialExpressionComponentMask_0
    float n97 = saturate(n96*P_Rain01_A_Smooth-P_Rain01_A_Offset); // MaterialExpressionMaterialFunctionCall_20
    float n98 = (n33.rgba).a; // MaterialExpressionComponentMask_1
    float n99 = saturate(n98*P_Rain02_A_Smooth-P_Rain02_A_Offset); // MaterialExpressionMaterialFunctionCall_21
    float n100 = (n97 + n99); // MaterialExpressionAdd_1
    float n101 = saturate(n100); // MaterialExpressionSaturate_7
    float3 n102 = lerp(n95,lerp(n95*P_RainMask_Color.rgb,P_RainMask_Color.rgb,P_RainMask_Color.a),n101); // MaterialExpressionMaterialFunctionCall_15
    float3 n103 = lerp(n95,n102,P_RainStrengh); // MaterialExpressionLinearInterpolate_19
    float3 n104 = CameraPosition; // MaterialExpressionCameraPositionWS_0
    float3 n105 = WorldPosition; // MaterialExpressionWorldPosition_0
    float3 n106 = (n104 - n105.rgb); // MaterialExpressionSubtract_0
    float3 n107 = normalize(n106); // MaterialExpressionNormalize_3
    float3 n108 = float3(0.000000,0.000000,1.000000); // MaterialExpressionConstant3Vector_1
    float3 n109 = cross(n107,n108.rgb); // MaterialExpressionCrossProduct_0
    float3 n110 = normalize(n109); // MaterialExpressionNormalize_4
    float3 n111 = mul(n48,TangentToWorld); // MaterialExpressionTransform_6
    float3 n112 = GeometricNormal; // MaterialExpressionVertexNormalWS_2
    float3 n113 = lerp(n111,n112,P_Matcap_Normal_mod); // MaterialExpressionLinearInterpolate_8
    float n114 = dot(n110,n113); // MaterialExpressionDotProduct_6
    float3 n115 = cross(n107,n110); // MaterialExpressionCrossProduct_1
    float3 n116 = normalize(n115); // MaterialExpressionNormalize_7
    float n117 = dot(n113,n116); // MaterialExpressionDotProduct_4
    float2 n118 = float2(n114,n117); // MaterialExpressionAppendVector_1
    float2 n119 = float2(P_Matcap_UV_Adjust.r,P_Matcap_UV_Adjust.g); // MaterialExpressionAppendVector_2
    float2 n120 = (n118 * n119); // MaterialExpressionMultiply_10
    float2 n121 = float2(P_Matcap_UV_Adjust.b,P_Matcap_UV_Adjust.a); // MaterialExpressionAppendVector_3
    float2 n122 = (n120 - n121); // MaterialExpressionSubtract_2
    float4 n123 = Texture2DSample(T_Matcap_Color,T_Matcap_ColorSampler,n122); // MaterialExpressionTextureSampleParameter2D_2
    float3 n124 = (n123.rgb * P_Matcap_Color.rgb); // MaterialExpressionMultiply_11
    float n125 = (n58 * n53); // MaterialExpressionMultiply_13
    float3 n126 = (n124 * n125); // MaterialExpressionMultiply_12
    float3 n127 = (n103 + n126); // MaterialExpressionAdd_3
    float3 n128 = CameraPosition; // MaterialExpressionCameraPositionWS_3
    float3 n129 = WorldPosition; // MaterialExpressionWorldPosition_3
    float3 n130 = (n128 - n129.rgb); // MaterialExpressionSubtract_6
    float3 n131 = normalize(n130); // MaterialExpressionNormalize_14
    float3 n132 = float3(0.000000,0.000000,1.000000); // MaterialExpressionConstant3Vector_4
    float3 n133 = cross(n131,n132.rgb); // MaterialExpressionCrossProduct_6
    float3 n134 = normalize(n133); // MaterialExpressionNormalize_15
    float3 n135 = mul(n48,TangentToWorld); // MaterialExpressionTransform_10
    float3 n136 = GeometricNormal; // MaterialExpressionVertexNormalWS_5
    float3 n137 = lerp(n135,n136,P_RainMatcap_Normal_mod); // MaterialExpressionLinearInterpolate_15
    float n138 = dot(n134,n137); // MaterialExpressionDotProduct_12
    float3 n139 = cross(n131,n134); // MaterialExpressionCrossProduct_7
    float3 n140 = normalize(n139); // MaterialExpressionNormalize_16
    float n141 = dot(n137,n140); // MaterialExpressionDotProduct_11
    float2 n142 = float2(n138,n141); // MaterialExpressionAppendVector_11
    float2 n143 = float2(P_RainMatcap_UV_Adjust.r,P_RainMatcap_UV_Adjust.g); // MaterialExpressionAppendVector_12
    float2 n144 = (n142 * n143); // MaterialExpressionMultiply_30
    float2 n145 = float2(P_RainMatcap_UV_Adjust.b,P_RainMatcap_UV_Adjust.a); // MaterialExpressionAppendVector_13
    float2 n146 = (n144 - n145); // MaterialExpressionSubtract_7
    float4 n147 = Texture2DSample(T_RainMatcap_Color,T_RainMatcap_ColorSampler,n146); // MaterialExpressionTextureSampleParameter2D_14
    float3 n148 = (n147.rgb * P_RainMatcap_Color.rgb); // MaterialExpressionMultiply_31
    float n149 = (n26.rgba).b; // MaterialExpressionComponentMask_8
    float n150 = saturate(n149*P_Rain01_Mask_Smooth-P_Rain01_Mask_Offset); // MaterialExpressionMaterialFunctionCall_38
    float n151 = (n33.rgba).a; // MaterialExpressionComponentMask_9
    float n152 = saturate(n151*P_Rain02_Mask_Smooth-P_Rain02_Mask_Offset); // MaterialExpressionMaterialFunctionCall_39
    float n153 = (n150 + n152); // MaterialExpressionAdd_5
    float n154 = saturate(n153); // MaterialExpressionSaturate_6
    float n155 = (n44 * n154); // MaterialExpressionMultiply_36
    float n156 = (n155 * n53); // MaterialExpressionMultiply_34
    float3 n157 = (n148 * n156); // MaterialExpressionMultiply_32
    float3 n158 = (P_RainStrengh * n157); // MaterialExpressionMultiply_40
    float3 n159 = (n127 + n158); // MaterialExpressionAdd_6
    float n160 = 0; // MaterialExpressionConstant_5
    float n161 = 0; // MaterialExpressionConstant_3
    float n162 = (n160 + n161); // MaterialExpressionAdd_8
    float3 n163 = (n159 + n162); // MaterialExpressionAdd_10
    float n164 = 0; // MaterialExpressionConstant_7
    float3 n165 = (n163 + n164); // MaterialExpressionAdd_2
    float3 n166 = (n165 * P_MSRE.a); // MaterialExpressionMultiply_1
    float n167 = 0; // MaterialExpressionConstant_6
    float3 n168 = (n166 + n167); // MaterialExpressionAdd_7
    float n169 = (n160 + n161); // MaterialExpressionAdd_9
    float3 n170 = (n168 + n169); // MaterialExpressionAdd_11
    float3 n171 = (n170*exp(-(P_EyeAdaptationlnverse)*log(max(Exposure,1e-8)))); // MaterialExpressionEyeAdaptationInverse_1
    float3 n172 = (n165*exp(-(P_EyeAdaptationlnverse)*log(max(Exposure,1e-8)))); // MaterialExpressionEyeAdaptationInverse_0
    float n173 = (1-(n83)); // MaterialExpressionOneMinus_5
    float n174 = lerp(P_MSRE.b,P_Roughnessmap_Strengh,n173); // MaterialExpressionLinearInterpolate_9
    float n175 = (n174 * P_RainRoughness_Strengh); // MaterialExpressionMultiply_42
    float n176 = lerp(n174,n175,P_RainStrengh); // MaterialExpressionLinearInterpolate_20
    float n177 = (n0.a * P_AlphaStrengh); // MaterialExpressionMultiply_20
    float n178 = (n177 * P_AlphaStrengh); // MaterialExpressionMultiply_14
    OutBaseColor = n172;
    OutMetallic = P_MSRE.r;
    OutSpecular = P_MSRE.g;
    OutRoughness = n176;
    OutNormal = n48;
    OutOpacity = n178;
    return n171;
}
