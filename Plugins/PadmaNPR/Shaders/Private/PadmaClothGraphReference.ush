    float n57 = dot(n56.rgba,P_AO); // MaterialExpressionChannelMaskParameter_1
    float n58 = saturate(n57.r*P_AO_Mask_Smooth-P_AO_Mask_Offset); // MaterialExpressionMaterialFunctionCall_2
    float3 n59 = lerp(n55,n54,n58); // MaterialExpressionLinearInterpolate_0
    float3 n60 = ViewDirection; // MaterialExpressionCameraVectorWS_2
    float3 n61 = mul(n48,TangentToWorld); // MaterialExpressionTransform_4
    float3 n62 = normalize(mul(n48,TangentToWorld)); // MaterialExpressionPixelNormalWS_1
