    out float OutRoughness,
    out float3 OutNormal,
    out float OutOpacity
)
{
    float4 n0 = Texture2DSample(T_BaseTex,T_BaseTexSampler,UV); // MaterialExpressionTextureSampleParameter2D_5
    float3 n1 = lerp(FilmToneMapInverse(n0.rgb),n0.rgb,saturate(P_Tonemap)); // MaterialExpressionMaterialFunctionCall_18
    float3 n2 = pow(max(n1,0),P_BaseColor_Power); // MaterialExpressionPower_5
    float3 n3 = saturate(n2); // MaterialExpressionSaturate_2
    float3 n4 = (n3 * P_BaseColor.rgb); // MaterialExpressionMultiply_45
    float3 n5 = (P_Lam_Shadow_Color.rgb * n4); // MaterialExpressionMultiply_2
    float3 n6 = LightDirection; // MaterialExpressionSkyAtmosphereLightDirection_0
    float3 n7 = normalize(n6); // MaterialExpressionNormalize_0
    float4 n8 = Texture2DSample(T_Normal,T_NormalSampler,UV); // MaterialExpressionTextureSampleParameter2D_1
    float3 n9 = PadmaReferenceUnpack(float2(n8.r,n8.g)); // MaterialExpressionMaterialFunctionCall_32
    float n10 = (1-(P_Base_Normal_Strengh)); // MaterialExpressionOneMinus_0
    float3 n11 = lerp(n9,float3(0,0,1),n10); // MaterialExpressionMaterialFunctionCall_6
    float3 n12 = ViewDirection; // MaterialExpressionCameraVectorWS_1
    float3 n13 = mul(TangentToWorld,n12); // MaterialExpressionTransform_1
    float3 n14 = normalize(n13); // MaterialExpressionNormalize_5
    float n15 = (1-(P_Camera_Normal_Strengh)); // MaterialExpressionOneMinus_7
    float3 n16 = lerp(n14,float3(0,0,1),n15); // MaterialExpressionMaterialFunctionCall_25
    float3 n17 = LightDirection; // MaterialExpressionSkyAtmosphereLightDirection_5
    float3 n18 = mul(TangentToWorld,n17); // MaterialExpressionTransform_2
    float3 n19 = normalize(n18); // MaterialExpressionNormalize_6
    float n20 = (1-(P_LightNormal_Strengh)); // MaterialExpressionOneMinus_6
    float3 n21 = lerp(n19,float3(0,0,1),n20); // MaterialExpressionMaterialFunctionCall_26
    float3 n22 = PadmaReferenceBlendNormals(n16,n21); // MaterialExpressionMaterialFunctionCall_28
    float3 n23 = PadmaReferenceBlendNormals(n11,n22); // MaterialExpressionMaterialFunctionCall_24
    float3 n24 = float3(0.000000,0.000000,1.000000); // MaterialExpressionConstant3Vector_2
    float2 n25 = (UV*P_Rain01_Normal_SXYS.r+float2(P_Rain01_Normal_SXYS.g,P_Rain01_Normal_SXYS.b)); // MaterialExpressionMaterialFunctionCall_19
    float4 n26 = Texture2DSample(T_T_Rain01,T_T_Rain01Sampler,n25); // MaterialExpressionTextureSampleParameter2D_6
    float n27 = (n26.rgba).r; // MaterialExpressionComponentMask_2
    float n28 = (n26.rgba).g; // MaterialExpressionComponentMask_3
    float3 n29 = PadmaReferenceUnpack(float2(n27,n28)); // MaterialExpressionMaterialFunctionCall_22
    float n30 = (1-(P_Rain01_Normal_SXYS.a)); // MaterialExpressionOneMinus_12
    float3 n31 = lerp(n29,float3(0,0,1),n30); // MaterialExpressionMaterialFunctionCall_23
    float2 n32 = (UV*P_Rain02_Normal_SXYS.r+float2(P_Rain02_Normal_SXYS.g,P_Rain02_Normal_SXYS.b)); // MaterialExpressionMaterialFunctionCall_30
    float4 n33 = Texture2DSample(T_T_Rain02,T_T_Rain02Sampler,n32); // MaterialExpressionTextureSampleParameter2D_3
    float n34 = (n33.rgba).r; // MaterialExpressionComponentMask_5
    float n35 = (n33.rgba).g; // MaterialExpressionComponentMask_6
    float3 n36 = PadmaReferenceUnpack(float2(n34,n35)); // MaterialExpressionMaterialFunctionCall_29
    float n37 = (1-(P_Rain02_Normal_SXYS.a)); // MaterialExpressionOneMinus_11
    float3 n38 = lerp(n36,float3(0,0,1),n37); // MaterialExpressionMaterialFunctionCall_27
    float3 n39 = PadmaReferenceBlendNormals(n31,n38); // MaterialExpressionMaterialFunctionCall_16
    float2 n40 = UV; // MaterialExpressionTextureCoordinate_2
    float2 n41 = (n40 * P_Noise_UV_Scale); // MaterialExpressionMultiply_17
    float4 n42 = Texture2DSample(T_RainNoise_Mask,T_RainNoise_MaskSampler,n41); // MaterialExpressionTextureSampleParameter2D_10
    float n43 = saturate(n42.r*P_Noise_Smooth-P_Noise_Offset); // MaterialExpressionMaterialFunctionCall_4
    float n44 = saturate(n43); // MaterialExpressionSaturate_8
    float3 n45 = lerp(n24.rgb,n39,n44); // MaterialExpressionLinearInterpolate_12
    float3 n46 = PadmaReferenceBlendNormals(n23,n45); // MaterialExpressionMaterialFunctionCall_17
    float3 n47 = lerp(n23,n46,P_RainNormal_Strengh); // MaterialExpressionLinearInterpolate_11
    float3 n48 = lerp(n23,n47,P_RainStrengh); // MaterialExpressionLinearInterpolate_18
    float3 n49 = mul(n48,TangentToWorld); // MaterialExpressionTransform_3
    float3 n50 = GeometricNormal; // MaterialExpressionVertexNormalWS_0
    float3 n51 = lerp(n49,n50,P_Lam_Normal_Mod); // MaterialExpressionLinearInterpolate_2
    float n52 = dot(n7,n51); // MaterialExpressionDotProduct_0
    float n53 = saturate(n52*P_Lam_Smooth-P_Lam_Offset); // MaterialExpressionMaterialFunctionCall_1
    float3 n54 = lerp(n5,n4,n53); // MaterialExpressionLinearInterpolate_3
    float3 n55 = (P_AO_Color.rgb * n54); // MaterialExpressionMultiply_0
