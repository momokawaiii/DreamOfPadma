    float3 n69 = GeometricNormal; // MaterialExpressionVertexNormalWS_1
    float n70 = dot(n68,n69); // MaterialExpressionDotProduct_3
    float n71 = (n66 * n70); // MaterialExpressionMultiply_4
    float n72 = saturate(n71); // MaterialExpressionSaturate_5
    float3 n73 = lerp(n59,lerp(n59*P_Rim_HighLight_Color.rgb,P_Rim_HighLight_Color.rgb,P_Rim_HighLight_Color.a),n72); // MaterialExpressionMaterialFunctionCall_9
    float n74 = (1-(P_GGX_Normal_Strengh)); // MaterialExpressionOneMinus_3
    float3 n75 = lerp(n48,float3(0,0,1),n74); // MaterialExpressionMaterialFunctionCall_11
    float3 n76 = LightDirection; // MaterialExpressionSkyAtmosphereLightDirection_2
    float3 n77 = ViewDirection; // MaterialExpressionCameraVectorWS_3
