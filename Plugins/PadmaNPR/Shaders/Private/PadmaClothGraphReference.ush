    float n65 = saturate(n64*P_Rim_HighLight_Smooth-P_Rim_HighLight_Offset); // MaterialExpressionMaterialFunctionCall_7
    float n66 = (1-(n65)); // MaterialExpressionOneMinus_2
    float3 n67 = LightDirection; // MaterialExpressionSkyAtmosphereLightDirection_1
