// Flat card frame and back motif, sampled from Padma's existing illustration atlas.
float2 uv=UV;
float edge=min(min(uv.x,1-uv.x),min(uv.y,1-uv.y));
float aa=max(fwidth(edge),.001);
float shape=smoothstep(0,aa,edge);
float3 color=float3(.012,.029,.065);
float frame=(1-smoothstep(.008,.013,abs(edge-.028))) + (1-smoothstep(.002,.005,abs(edge-.052)))*.35;
color+=frame*lerp(float3(.3,.5,.67),Accent.rgb,.3);
float2 artUV=(uv-float2(.084,.09))/float2(.832,.77);
float art=step(0,artUV.x)*step(artUV.x,1)*step(0,artUV.y)*step(artUV.y,1);
float col=fmod(floor(ArtIndex+.1),3),row=floor(ArtIndex/3);
float2 atlasUV=(float2(col,row)+lerp(.01,.99,saturate(artUV)))/3.0;
float3 portrait=Texture2DSample(CardAtlas,CardAtlasSampler,atlasUV).rgb;
color=lerp(color,portrait*float3(.87,.94,1),art*(1-step(.5,Back)));
float2 cp=(uv-.5)*float2(1,1.58);
float radius=length(cp);
float rings=(1-smoothstep(.002,.006,abs(radius-.28)))+(1-smoothstep(.001,.004,abs(radius-.235)))*.6;
float diamond=abs(cp.x)+abs(cp.y)*.65;
float mark=1-smoothstep(.005,.01,abs(diamond-.16));
float rays=pow(abs(sin(atan2(cp.y,cp.x)*12.0)),30.0)*smoothstep(.16,.24,radius)*(1-smoothstep(.28,.31,radius));
color+=step(.5,Back)*(rings+mark+rays*.35)*float3(.22,.53,.82);
float ruleLine=(1-smoothstep(.001,.004,abs(uv.y-.901)))*step(.2,uv.x)*step(uv.x,.8);
color+=ruleLine*float3(.30,.55,.75);
return float4(color,shape);
