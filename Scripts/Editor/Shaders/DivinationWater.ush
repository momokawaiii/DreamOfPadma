// Original procedural UI water. No Arknights textures or shader code are included.
float2 p = UV * float2(1.77778, 1.0);
float t = PreviewTime;
float2 q = p + float2(sin(p.y*8.0+t*.22),cos(p.x*6.0-t*.17))*.07;
float wave = sin(q.x*18.0 + q.y*12.0 + sin(q.y*22.0-t*.39)*1.4+t*.3);
float wave2 = sin(q.x*29.0-q.y*19.0+sin(q.x*13.0+t*.23)*1.1-t*.24);
float caustic = pow(saturate(1.0-abs(wave*.6+wave2*.4)),12.0);
float fold = .73 + sin(UV.x*6.0+t*.12)*.11;
float water = smoothstep(fold-.30, fold+.1, UV.y);
float haze = exp(-length((UV-float2(.5,.53))*float2(1.1,1.7))*4.5);
float3 color = float3(.0015,.006,.023) + Accent.rgb*haze*.11;
color += Accent.rgb*water*(.018+caustic*.075)*WaterStrength;
float beams = pow(saturate(sin(q.x*13.0+q.y*3.0+t*.05)),20.0);
color += Accent.rgb*beams*water*.027*WaterStrength;
float grain = frac(sin(dot(floor(UV*float2(1600,900)),float2(12.9898,78.233)))*43758.5453);
color += grain*.0012;
float horizon = exp(-abs(UV.y-.77-sin(UV.x*16.0-t*.3)*.013)*80.0);
color += Accent.rgb*horizon*.045*WaterStrength;
float vignette = saturate(1.2-length((UV-.5)*float2(1.2,1.1)));
color *= vignette;
color += Accent.rgb*RevealPhase*.006;
return float4(color,1);
